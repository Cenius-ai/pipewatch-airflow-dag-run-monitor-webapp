# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored and should NEVER be committed.
# Values here are placeholders / examples ONLY.

# ─── Required ───

# Provider: Database
# Docs: Connection string for your database; format: <scheme>://<user>:<password>@<host>:<port>/<dbname>
# Database configuration. Obtain from the provider dashboard.
DATABASE_URL=sqlite:///./app.db

# dev-only; regenerate for production. App configuration value.
SECRET=cenius-dev-c01fe5ffc01c36383a697aa54f6f7e4a

# Provider: App secret
# Docs: Generate via `openssl rand -hex 32`
# dev-only; regenerate for production. App secret configuration. Obtain from the provider dashboard.
SECRET_KEY=cenius-dev-f36d755fdbd4cbe036c70d54f809c187

# ─── Optional ───

# Provider: Runtime config
# Docs: Standard runtime configuration; not secret
# Runtime config configuration. Obtain from the provider dashboard.
PORT=8080

# App configuration value.
# (unset by default — the app's own built-in default applies)
# PYTHON_BIN=
